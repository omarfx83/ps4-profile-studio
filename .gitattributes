# Normalise line endings so the repository is consistent on every OS.
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf

*.png   binary
*.ico   binary
*.ttf   binary
*.zip   binary
